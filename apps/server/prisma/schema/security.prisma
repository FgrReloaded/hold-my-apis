model ApiKey {
  id           String    @id @default(cuid())
  name         String
  key          String    @unique
  keyHash      String    @unique
  prefix       String
  isActive     Boolean   @default(true)
  expiresAt    DateTime?
  lastUsedAt   DateTime?
  permissions  Json?
  ipWhitelist  String[]
  requestCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organizationId String
  createdBy      String

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator       User              @relation(fields: [createdBy], references: [id])
  subscriptions ApiSubscription[]
  logs          ApiLog[]

  @@map("api_key")
}

model ApiSubscription {
  id             String             @id @default(cuid())
  status         SubscriptionStatus @default(ACTIVE)
  subscribedAt   DateTime           @default(now())
  unsubscribedAt DateTime?

  apiId    String
  apiKeyId String

  api    Api    @relation(fields: [apiId], references: [id], onDelete: Cascade)
  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiId, apiKeyId])
  @@map("api_subscription")
}

model RateLimit {
  id         String          @id @default(cuid())
  name       String
  requests   Int
  windowSize Int
  windowType RateLimitWindow @default(SLIDING)
  isGlobal   Boolean         @default(false)
  priority   Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  apiId String

  api            Api                 @relation(fields: [apiId], references: [id], onDelete: Cascade)
  endpointLimits EndpointRateLimit[]

  @@map("rate_limit")
}

model EndpointRateLimit {
  id String @id @default(cuid())

  endpointId  String
  rateLimitId String

  endpoint  Endpoint  @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  rateLimit RateLimit @relation(fields: [rateLimitId], references: [id], onDelete: Cascade)

  @@unique([endpointId, rateLimitId])
  @@map("endpoint_rate_limit")
}

model SecurityPolicy {
  id          String             @id @default(cuid())
  name        String
  description String?
  type        SecurityPolicyType
  config      Json
  isEnabled   Boolean            @default(true)
  priority    Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("security_policy")
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  EXPIRED
}

enum RateLimitWindow {
  FIXED
  SLIDING
}

enum SecurityPolicyType {
  IP_WHITELIST
  IP_BLACKLIST
  CORS
  CSRF_PROTECTION
  JWT_VALIDATION
  OAUTH_VALIDATION
  CUSTOM_HEADER
  REQUEST_SIZE_LIMIT
  CONTENT_TYPE_VALIDATION
}

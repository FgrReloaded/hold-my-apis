model ApiLog {
  id              String        @id @default(cuid())
  timestamp       DateTime      @default(now())
  method          HttpMethod
  path            String
  statusCode      Int
  responseTime    Int
  requestSize     Int?
  responseSize    Int?
  userAgent       String?
  ipAddress       String
  country         String?
  region          String?
  city            String?
  errorMessage    String?
  requestHeaders  Json?
  responseHeaders Json?
  requestBody     Json?
  responseBody    Json?

  apiId           String
  endpointId      String?
  apiKeyId        String?

  api             Api           @relation(fields: [apiId], references: [id], onDelete: Cascade)
  endpoint        Endpoint?     @relation(fields: [endpointId], references: [id])
  apiKey          ApiKey?       @relation(fields: [apiKeyId], references: [id])

  @@index([apiId, timestamp])
  @@index([endpointId, timestamp])
  @@index([apiKeyId, timestamp])
  @@index([ipAddress, timestamp])
  @@map("api_log")
}

model ApiMetrics {
  id              String    @id @default(cuid())
  date            DateTime  @db.Date
  hour            Int?
  totalRequests   Int       @default(0)
  successRequests Int       @default(0)
  errorRequests   Int       @default(0)
  avgResponseTime Float     @default(0)
  minResponseTime Int       @default(0)
  maxResponseTime Int       @default(0)
  totalDataIn     BigInt    @default(0)
  totalDataOut    BigInt    @default(0)
  uniqueUsers     Int       @default(0)

  apiId           String
  endpointId      String?

  api             Api       @relation(fields: [apiId], references: [id], onDelete: Cascade)
  endpoint        Endpoint? @relation(fields: [endpointId], references: [id])

  @@unique([apiId, endpointId, date, hour])
  @@index([apiId, date])
  @@index([endpointId, date])
  @@map("api_metrics")
}

model Alert {
  id              String        @id @default(cuid())
  name            String
  description     String?
  type            AlertType
  condition       Json
  threshold       Float?
  isEnabled       Boolean       @default(true)
  lastTriggered   DateTime?
  triggerCount    Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  apiId           String?
  organizationId  String
  createdBy       String

  api             Api?          @relation(fields: [apiId], references: [id], onDelete: Cascade)
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator         User          @relation(fields: [createdBy], references: [id])
  notifications   AlertNotification[]

  @@map("alert")
}

model AlertNotification {
  id              String              @id @default(cuid())
  type            NotificationType
  recipient       String
  isEnabled       Boolean             @default(true)
  lastSent        DateTime?

  alertId         String

  alert           Alert               @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@map("alert_notification")
}

model HealthCheck {
  id              String              @id @default(cuid())
  name            String
  url             String
  method          HttpMethod          @default(GET)
  headers         Json?
  body            String?
  expectedStatus  Int                 @default(200)
  expectedBody    String?
  timeout         Int                 @default(30)
  interval        Int                 @default(60)
  retries         Int                 @default(3)
  isEnabled       Boolean             @default(true)
  lastChecked     DateTime?
  lastStatus      HealthCheckStatus?
  consecutiveFailures Int             @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  apiId           String

  api             Api                 @relation(fields: [apiId], references: [id], onDelete: Cascade)
  results         HealthCheckResult[]

  @@map("health_check")
}

model HealthCheckResult {
  id              String            @id @default(cuid())
  timestamp       DateTime          @default(now())
  status          HealthCheckStatus
  responseTime    Int?
  statusCode      Int?
  errorMessage    String?
  responseBody    String?

  healthCheckId   String

  healthCheck     HealthCheck       @relation(fields: [healthCheckId], references: [id], onDelete: Cascade)

  @@index([healthCheckId, timestamp])
  @@map("health_check_result")
}

enum AlertType {
  HIGH_ERROR_RATE
  HIGH_RESPONSE_TIME
  HIGH_TRAFFIC
  LOW_TRAFFIC
  API_DOWN
  RATE_LIMIT_EXCEEDED
  SECURITY_BREACH
  CUSTOM
}

enum NotificationType {
  EMAIL
  SMS
  WEBHOOK
  SLACK
  DISCORD
  TEAMS
}

enum HealthCheckStatus {
  HEALTHY
  UNHEALTHY
  TIMEOUT
  ERROR
}

model ApiDocumentation {
  id        String            @id @default(cuid())
  title     String
  content   String
  type      DocumentationType
  order     Int               @default(0)
  isPublic  Boolean           @default(false)
  slug      String
  tags      String[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  apiId    String
  authorId String

  api    Api  @relation(fields: [apiId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@unique([apiId, slug])
  @@map("api_documentation")
}

model Gateway {
  id            String            @id @default(cuid())
  name          String
  domain        String            @unique
  isActive      Boolean           @default(true)
  config        Json?
  sslEnabled    Boolean           @default(true)
  sslCert       String?
  sslKey        String?
  customDomain  String?
  loadBalancing LoadBalancingType @default(ROUND_ROBIN)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  organizationId String

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  routes       GatewayRoute[]

  @@map("gateway")
}

model GatewayRoute {
  id        String       @id @default(cuid())
  path      String
  methods   HttpMethod[]
  targetUrl String
  isActive  Boolean      @default(true)
  priority  Int          @default(0)
  timeout   Int          @default(30)
  retries   Int          @default(3)

  authRequired      Boolean @default(false)
  rateLimitId       String?
  transformRequest  Json?
  transformResponse Json?
  cacheConfig       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gatewayId String
  apiId     String

  gateway Gateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  api     Api     @relation(fields: [apiId], references: [id], onDelete: Cascade)

  @@unique([gatewayId, path])
  @@map("gateway_route")
}

model Webhook {
  id            String         @id @default(cuid())
  name          String
  url           String
  secret        String?
  events        WebhookEvent[]
  isActive      Boolean        @default(true)
  retryPolicy   Json?
  headers       Json?
  lastTriggered DateTime?
  successCount  Int            @default(0)
  failureCount  Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  apiId String

  api        Api               @relation(fields: [apiId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@map("webhook")
}

model WebhookDelivery {
  id           String       @id @default(cuid())
  timestamp    DateTime     @default(now())
  event        WebhookEvent
  payload      Json
  response     Json?
  statusCode   Int?
  success      Boolean
  attempts     Int          @default(1)
  nextRetry    DateTime?
  errorMessage String?

  webhookId String

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, timestamp])
  @@map("webhook_delivery")
}

model Cache {
  id           String   @id @default(cuid())
  key          String   @unique
  value        String
  headers      Json?
  expiresAt    DateTime
  hitCount     Int      @default(0)
  createdAt    DateTime @default(now())
  lastAccessed DateTime @default(now())

  apiId      String
  endpointId String?

  api      Api       @relation(fields: [apiId], references: [id], onDelete: Cascade)
  endpoint Endpoint? @relation(fields: [endpointId], references: [id])

  @@index([apiId, expiresAt])
  @@index([endpointId, expiresAt])
  @@map("cache")
}

enum DocumentationType {
  OVERVIEW
  GETTING_STARTED
  AUTHENTICATION
  ENDPOINTS
  EXAMPLES
  SDK
  CHANGELOG
  FAQ
  TROUBLESHOOTING
  CUSTOM
}

enum LoadBalancingType {
  ROUND_ROBIN
  LEAST_CONNECTIONS
  WEIGHTED_ROUND_ROBIN
  IP_HASH
  RANDOM
}

enum WebhookEvent {
  API_CREATED
  API_UPDATED
  API_DELETED
  ENDPOINT_CREATED
  ENDPOINT_UPDATED
  ENDPOINT_DELETED
  KEY_CREATED
  KEY_DELETED
  RATE_LIMIT_EXCEEDED
  API_ERROR
  HEALTH_CHECK_FAILED
}

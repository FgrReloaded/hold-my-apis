model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  website     String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members        OrganizationMember[]
  apis           Api[]
  apiKeys        ApiKey[]
  Gateway        Gateway[]
  Alert          Alert[]
  SecurityPolicy SecurityPolicy[]

  @@map("organization")
}

model OrganizationMember {
  id       String           @id @default(cuid())
  role     OrganizationRole @default(MEMBER)
  joinedAt DateTime         @default(now())

  userId         String
  organizationId String

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("organization_member")
}

model Api {
  id               String        @id @default(cuid())
  name             String
  slug             String
  description      String?
  version          String        @default("1.0.0")
  baseUrl          String
  status           ApiStatus     @default(DRAFT)
  visibility       ApiVisibility @default(PRIVATE)
  logoUrl          String?
  documentationUrl String?
  supportEmail     String?
  termsOfService   String?
  privacyPolicy    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organizationId String
  createdBy      String

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator       User               @relation(fields: [createdBy], references: [id])
  endpoints     Endpoint[]
  subscriptions ApiSubscription[]
  versions      ApiVersion[]
  documentation ApiDocumentation[]
  rateLimits    RateLimit[]
  webhooks      Webhook[]
  GatewayRoute  GatewayRoute[]
  Cache         Cache[]
  ApiLog        ApiLog[]
  ApiMetrics    ApiMetrics[]
  Alert         Alert[]
  HealthCheck   HealthCheck[]

  @@unique([organizationId, slug])
  @@map("api")
}

model ApiVersion {
  id           String    @id @default(cuid())
  version      String
  changelog    String?
  isDeprecated Boolean   @default(false)
  deprecatedAt DateTime?
  sunsetAt     DateTime?
  createdAt    DateTime  @default(now())

  apiId String

  api       Api        @relation(fields: [apiId], references: [id], onDelete: Cascade)
  endpoints Endpoint[]

  @@unique([apiId, version])
  @@map("api_version")
}

model Endpoint {
  id             String     @id @default(cuid())
  path           String
  method         HttpMethod
  name           String
  description    String?
  summary        String?
  operationId    String?
  isDeprecated   Boolean    @default(false)
  isInternal     Boolean    @default(false)
  requestSchema  Json?
  responseSchema Json?
  headers        Json?
  queryParams    Json?
  pathParams     Json?
  examples       Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  apiId     String
  versionId String?

  api        Api                 @relation(fields: [apiId], references: [id], onDelete: Cascade)
  version    ApiVersion?         @relation(fields: [versionId], references: [id])
  rateLimits EndpointRateLimit[]
  logs       ApiLog[]
  Cache      Cache[]
  ApiMetrics ApiMetrics[]

  @@unique([apiId, versionId, method, path])
  @@map("endpoint")
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ApiStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
  ARCHIVED
}

enum ApiVisibility {
  PUBLIC
  PRIVATE
  INTERNAL
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
  OPTIONS
  TRACE
}
